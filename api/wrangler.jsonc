{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "logic-master-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "logic-master-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL_GLOBAL", "namespace_id": "7001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "7002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_ATTEMPT", "namespace_id": "7003", "simple": { "limit": 10, "period": 60 } }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": { "ALLOWED_EMAIL_DOMAINS": "icen.ufpa.br" },
  "observability": { "enabled": true }
}
